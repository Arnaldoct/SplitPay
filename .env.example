# Example environment file for SplitPay.
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# Placeholder values only. Vars prefixed NEXT_PUBLIC_ are exposed to the browser.

# App
NEXT_PUBLIC_APP_URL=https://your-app.example.com   # Client-safe: public base URL of the app
ADMIN_EMAIL=admin@example.com                       # Server only: email allowed to access /admin routes

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # Client-safe: Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                 # Client-safe: Supabase anonymous (public) key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key             # Server only, never exposed: bypasses RLS (admin routes only)

# Database
DATABASE_URL=postgresql://user:password@host:5432/postgres  # Server only: Postgres connection string

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx   # Client-safe: Stripe publishable key
STRIPE_SECRET_KEY=sk_test_xxx                    # Server only: Stripe secret key
STRIPE_WEBHOOK_SECRET=whsec_xxx                  # Server only: verifies Stripe webhook signatures

# Resend
RESEND_API_KEY=re_xxx                            # Server only: Resend API key for email receipts

# Sentry
SENTRY_DSN=https://your-dsn@sentry.io/project    # Both client and server: error reporting DSN
